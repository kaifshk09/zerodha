# Dummy env file so local runs don't crash.
# Replace these with real values (especially MONGO_URL) for production.

NODE_ENV=development
PORT=5000

# Mongo connection string (Atlas). REQUIRED in the DB-enabled backend.
# Example:
# MONGO_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_URL=

